# ============================================================
#  个人主页 · Git 忽略规则
# ============================================================

# --- 依赖：体积大且可重新安装 ---
node_modules/
**/node_modules/

# --- DeepWorks 运行时数据 ---
# 含本机绝对路径、会话临时文件、日志，属于本机私有信息，不随项目共享
.deepworks/

# --- 本机工作区元数据：含本机绝对路径，无需随项目共享 ---
.opencode/deepworks.json

# --- 调试截图：页面比对用的中间产物，不是素材 ---
uploads/**/_inspect/

# --- 编辑器与系统文件 ---
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# --- 密钥与环境变量 ---
# 提醒：任何 Supabase service_role key、GitHub Token 都不要写进仓库
.env
.env.*
